{
  "name": "hanam-bbq-mongolia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node --env-file-if-exists=.env scripts/ensure-local-db.mjs",
    "prestart": "node --env-file-if-exists=.env scripts/ensure-local-db.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "test": "tsx --test tests/*.test.ts",
    "verify": "node --env-file=.env --import tsx scripts/verify.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-serif": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "2.4.0",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "effect": "3.22.5",
    "deepmerge-ts": "8.0.2"
  },
  "type": "module"
}
